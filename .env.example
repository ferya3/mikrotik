# ── Copy to .env and fill in. Never commit .env. ─────────────────────────────

# Database / cache (docker-compose builds DATABASE_URL and REDIS_URL from these)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# For running the API outside docker:
# DATABASE_URL=postgresql://nms:<password>@localhost:5432/nms
# REDIS_URL=redis://:<password>@localhost:6379

# Session signing key, >= 32 chars:        openssl rand -base64 48
JWT_SECRET=
SESSION_TTL_SEC=28800

# Router-credential encryption key (AES-256-GCM), 32 bytes base64:  openssl rand -base64 32
# Rotation: add CREDENTIALS_KEY_V2, set CREDENTIALS_ACTIVE_KEY_VERSION=2, re-save credentials, then remove V1.
CREDENTIALS_KEY_V1=
CREDENTIALS_ACTIVE_KEY_VERSION=1

# Only these source networks may reach the panel/API (comma separated CIDRs). Empty = no restriction.
ADMIN_IP_ALLOWLIST=
# Browser origins allowed by CORS. Empty when the panel and API share one origin behind Nginx.
CORS_ORIGINS=

# Monitoring
# How often each router is polled. Raise it (e.g. 30000) for small routers or many routers.
POLL_INTERVAL_MS=15000
POLL_CONCURRENCY=10
CPU_ALERT_THRESHOLD=90
METRICS_RETENTION_HOURS=24
ROUTER_TIMEOUT_MS=8000
# Bearer token Prometheus uses for /api/metrics (also write it to deploy/prometheus/metrics_token)
METRICS_TOKEN=

# Backups (cron, server time zone)
BACKUP_CRON="0 3 * * *"

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GRAFANA_ADMIN_PASSWORD=

# Published ports of the panel (Nginx). Change if 80/443 are already in use.
HTTP_PORT=80
HTTPS_PORT=443
